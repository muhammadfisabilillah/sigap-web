# ============================================================================
# SIGAP — contoh konfigurasi environment untuk Docker Compose
# ----------------------------------------------------------------------------
# Salin file ini menjadi `.env` lalu isi nilai aslinya:
#     cp .env.example .env
# PENTING: `.env` berisi rahasia dan TIDAK boleh di-commit (sudah di-gitignore).
# ============================================================================

# --- Database internal (service `db` pada compose.yaml) ---
# Gunakan password kuat — hanya huruf/angka (tanpa karakter URL khusus)
# agar URL koneksi yang dirangkai compose tetap valid.
POSTGRES_DB=sigap
POSTGRES_USER=sigap
POSTGRES_PASSWORD=ubah-saya-dengan-password-kuat

# Port host tempat aplikasi dipublish (VM Azure: 80; lokal: mis. 8080)
APP_PORT=80

# --- Supabase Storage (upload KTP verifikasi domisili) ---
# UPLOAD tetap memakai Supabase; data di Postgres container terpisah.
SUPABASE_URL="https://<nich>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service_role_key>"

# (opsional, untuk menjalankan project TANPA Docker di lokal)
# DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
