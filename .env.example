# ============================================================
# SIGAP — Sistem Informasi Gerak Aduan Publik
# Salin file ini menjadi .env dan isi dengan nilai yang benar.
# JANGAN pernah commit file .env ke repository!
# ============================================================

# --- Database (Supabase Postgres / PostgreSQL) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://postgres:your_password@db.xyzcompany.supabase.co:5432/postgres"

# --- Supabase (untuk Storage & Auth opsional) ---
NEXT_PUBLIC_SUPABASE_URL="https://xyzcompany.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# --- Sesi & Keamanan ---
# Gunakan string random minimal 32 karakter untuk produksi
# Contoh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="ganti_dengan_string_acak_minimal_32_karakter_untuk_produksi"

# --- Next.js ---
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="development"
